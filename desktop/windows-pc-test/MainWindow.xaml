<Window x:Class="LinguaCafe.PcTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LinguaCafe PC Test"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7F3E8">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Hidden" />

        <Border x:Name="StartupOverlay" Background="#F7F3E8">
            <Grid>
                <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LinguaCafe" FontSize="44" FontWeight="SemiBold" Foreground="#24483D" HorizontalAlignment="Center" />
                    <TextBlock Text="PC 测试版" Margin="0,6,0,30" FontSize="18" Foreground="#68746F" HorizontalAlignment="Center" />
                    <ProgressBar Height="6" IsIndeterminate="True" />
                    <TextBlock x:Name="StatusText" Margin="0,20,0,0" Text="正在准备测试运行时…" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Foreground="#1D2925" />
                    <TextBlock x:Name="ErrorText" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#A34438" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
