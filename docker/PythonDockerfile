FROM ubuntu:22.04

WORKDIR /app
RUN apt-get update -y \
        && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        pip \
        tzdata \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --gid 1000 laravel \
    && adduser --ingroup laravel --disabled-password --gecos "" --shell /bin/sh laravel
USER laravel

# Preserve downloaded wheels across interrupted PC-test builds (runtime stays unchanged).
# Allow official PyPI CDN downloads to survive slow reads without changing sources.
RUN --mount=type=cache,id=linguacafe-pc-test-pip,target=/home/laravel/.cache/pip,uid=1000,gid=1000 \
    pip --timeout 180 --retries 8 install -U \
        setuptools \
        wheel \
        lxml \
        lxml_html_clean \
#youtube api
        youtube_transcript_api \
#ebook library
        ebooklib \
#kanji reading
        pykakasi \
#bottle
        bottle \
#spacy (English-only product boundary)
        'spacy>=3.8,<3.9' \
#english morphology fallback
        lemminflect \
#chinese reading
        pinyin \
#subtitle file parser
        pysub-parser \
#website text parser
        newspaper3k \
        'https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl'

COPY ./tools /app

# Revision metadata must not invalidate the expensive dependency layers.
ARG PC_TEST_SOURCE_COMMIT=dev
LABEL org.opencontainers.image.revision=$PC_TEST_SOURCE_COMMIT
