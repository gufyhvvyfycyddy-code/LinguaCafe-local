{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/mimo-v2.5-free",

  "experimental": {
    "max_auto_retry": 0,
    "disable_fallback": true
  },

  "skills": {
    "paths": [
      ".opencode/skills",
      "C:/Users/Administrator/.codex/skills"
    ]
  },

  "permission": {
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "C:/Users/Administrator/.codex/skills/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "fastctx_run": "deny",
    "fastctx_run_background": "deny",
    "external_directory": {
      "C:/Users/Administrator/.codex/skills/**": "allow"
    }
  }
}
